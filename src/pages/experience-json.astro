---
import { existsSync, readFileSync, statSync } from 'node:fs';
import { createHash } from 'node:crypto';
import { execFileSync } from 'node:child_process';
import { dirname, join, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';
import Workspace from '../layouts/Workspace.astro';
import PhysicalCard from '../components/PhysicalCard.astro';
import TagChip from '../components/TagChip.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Prompt from '../components/Prompt.astro';

// Every figure on this page is computed when the site builds: bytes, lines and sha256 from
// public/experience.json itself, the parse result from JSON.parse, the commit from git.
// Nothing is typed in by hand, so nothing here can drift from the file it describes. If the
// file cannot be found the build fails with a clear message instead of showing a stale number.

function locate(rel: string): string {
  const tried: string[] = [];
  const probe = (p: string) => {
    tried.push(p);
    return existsSync(p) ? p : null;
  };
  const fromCwd = probe(resolve(process.cwd(), rel));
  if (fromCwd) return fromCwd;
  // Fallback: walk up from wherever this module runs (the source file in dev, a build chunk
  // under dist/ at build time; both sit inside the project).
  let dir = dirname(fileURLToPath(import.meta.url));
  for (let i = 0; i < 8; i++) {
    const hit = probe(resolve(dir, rel));
    if (hit) return hit;
    const parent = dirname(dir);
    if (parent === dir) break;
    dir = parent;
  }
  throw new Error(`experience-json.astro: cannot find ${rel}; looked in: ${tried.join(' | ')}`);
}

const jsonPath = locate(join('public', 'experience.json'));
const repoRoot = resolve(dirname(jsonPath), '..');
const text = readFileSync(jsonPath, 'utf8');
const sizeBytes = statSync(jsonPath).size;
const sizeKb = (sizeBytes / 1024).toFixed(1);
const fileLines = text.replace(/\r\n/g, '\n').split('\n');
if (fileLines.length > 0 && fileLines[fileLines.length - 1] === '') fileLines.pop(); // a trailing newline is not a line
const lineCount = fileLines.length;
const sha256 = createHash('sha256').update(text, 'utf8').digest('hex');

let doc: any = null;
let parseError: string | null = null;
try {
  doc = JSON.parse(text);
} catch (e) {
  parseError = e instanceof Error ? e.message : String(e);
}
const parseOk = parseError === null;
const lastUpdated: string = typeof doc?._last_updated === 'string' ? doc._last_updated : 'unknown';
const version: string = typeof doc?._version === 'string' ? doc._version : 'unknown';
const builtAt = new Date().toISOString().replace('T', ' ').slice(0, 16) + ' UTC';

// The repo's last commit, read from git at build with `git log -1 --format=%h,%ad`.
// execFileSync (no shell) so cmd.exe on Windows cannot expand the % signs. The first real
// commit of this repo is "v1" (e2a2059, 2026-10-11); when git is unavailable at build time
// that is what we show, labelled as the fallback it is.
let commit = { sha: 'e2a2059', date: '2026-10-11', source: 'recorded 2026-10-11 · git unavailable at build' };
try {
  const out = execFileSync('git', ['log', '-1', '--format=%h,%ad', '--date=short'], {
    cwd: repoRoot,
    encoding: 'utf8',
    stdio: ['ignore', 'pipe', 'ignore'],
  }).trim();
  const [sha, date] = out.split(',');
  if (sha && date) commit = { sha, date, source: 'git log -1 · read at build' };
} catch {
  // fallback above
}
const gitLive = commit.source.startsWith('git log');

// Syntax colouring for the cat view, token by token from the real file.
type Tok = { c: string; t: string };
const KEY = 'text-emerald-400';
const STR = 'text-[#e2cb85]';
const NUM = 'text-[#a78bfa]';
const LIT = 'text-rose-400';
const PUN = 'text-zinc-500';
const TOKEN_RE =
  /("(?:[^"\\]|\\.)*")(\s*:)?|(-?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?)|\b(true|false|null)\b|([{}\[\],:])|(\s+)|(.)/g;
function tokenize(line: string): Tok[] {
  const out: Tok[] = [];
  for (const m of line.matchAll(TOKEN_RE)) {
    if (m[1] !== undefined) {
      if (m[2] !== undefined) {
        out.push({ c: KEY, t: m[1] });
        out.push({ c: PUN, t: m[2] });
      } else {
        out.push({ c: STR, t: m[1] });
      }
    } else if (m[3] !== undefined) out.push({ c: NUM, t: m[3] });
    else if (m[4] !== undefined) out.push({ c: LIT, t: m[4] });
    else if (m[5] !== undefined) out.push({ c: PUN, t: m[5] });
    else out.push({ c: '', t: m[0] });
  }
  return out;
}
const renderedLines: Tok[][] = fileLines.map(tokenize);

// Example queries, answered from the parsed document so the answers cannot drift from the file.
const show = (v: unknown) => JSON.stringify(v);
const queries: { filter: string; out: string[] }[] = parseOk
  ? [
      { filter: '.basics.label', out: [show(doc.basics?.label)] },
      { filter: '.work[0].position', out: [show(doc.work?.[0]?.position)] },
      { filter: '.projects[].name', out: (doc.projects ?? []).map((p: any) => show(p.name)) },
      { filter: '.skills[0].keywords[]', out: (doc.skills?.[0]?.keywords ?? []).map(show) },
    ]
  : [];

const codeClass = 'font-mono text-[12px] bg-zinc-800/50 border border-zinc-700/50 px-1.5 py-0.5 rounded-sm';
const pointerClass =
  'bg-transparent border border-zinc-800 text-zinc-400 py-2 px-3 uppercase hover:bg-zinc-800 hover:text-zinc-200 transition-colors text-left flex justify-between items-center group no-underline cursor-pointer';
---

<Workspace
  title="experience.json · Ladon Davis"
  workspacePath="RESUME/EXPERIENCE.JSON"
  bottomNavFile="resume/experience.json"
  description="The résumé as structured data, JSON Resume–shaped: every number carries its date or its method. Size, lines, sha256 and last commit are computed when the site builds."
>
  <div class="max-w-[840px] mx-auto w-full">

    {/* PAGE HEADER */}
    <div class="mb-8">
      <div class="font-mono text-[11px] text-zinc-400 mb-4 tracking-widest">
        ~/WORKSPACE/RESUME/EXPERIENCE.JSON
      </div>
      <div class="flex items-center gap-4 mb-6">
        <h1 class="text-zinc-100 font-tight font-bold text-4xl tracking-tight">experience.json</h1>
        <span class="bg-amber-500/10 text-amber-400 border border-amber-500/30 text-[12px] px-2 py-1 font-mono rounded-sm uppercase tracking-widest translate-y-[2px]">
          {'{}'} · v{version}
        </span>
      </div>
      <div class="flex flex-wrap gap-2">
        <TagChip>JSON</TagChip>
        <TagChip>JSON Resume–shaped</TagChip>
        <TagChip>UTF-8</TagChip>
        <TagChip>{lineCount} lines</TagChip>
        <TagChip>updated {lastUpdated}</TagChip>
      </div>
    </div>

    {/* HERO: STAT-STYLE FILE METADATA CARD — every value computed at build */}
    <div class="relative bg-[#0c0c0e] border-2 border-emerald-500/40 shadow-[0_0_24px_rgba(16,185,129,0.06)] p-6 mb-12">
      <div class="absolute top-0 left-0 right-0 h-[1px] bg-white/10 pointer-events-none"></div>

      <div class="flex justify-between items-center mb-4 font-mono text-[10px] uppercase tracking-widest gap-4">
        <span class="text-zinc-400 font-semibold">$ stat experience.json</span>
        <span class="text-zinc-400 text-right">computed at build · {builtAt}</span>
      </div>

      <div class="grid grid-cols-2 gap-x-6 gap-y-2 font-mono text-[12px]">
        <div class="flex justify-between">
          <span class="text-zinc-400">FILE</span>
          <span class="text-emerald-400">experience.json</span>
        </div>
        <div class="flex justify-between">
          <span class="text-zinc-400">SIZE</span>
          <span class="text-zinc-300 tabular-nums">{sizeBytes.toLocaleString('en-US')} B · {sizeKb} KB</span>
        </div>
        <div class="flex justify-between">
          <span class="text-zinc-400">LINES</span>
          <span class="text-zinc-300 tabular-nums">{lineCount}</span>
        </div>
        <div class="flex justify-between">
          <span class="text-zinc-400">ENCODING</span>
          <span class="text-zinc-300">UTF-8</span>
        </div>
        <div class="flex justify-between">
          <span class="text-zinc-400">SCHEMA</span>
          <span class="text-zinc-300 truncate ml-2">JSON Resume–shaped · v{version}</span>
        </div>
        <div class="flex justify-between">
          <span class="text-zinc-400">VALIDATION</span>
          {parseOk ? (
            <span class="text-emerald-400">JSON.parse OK</span>
          ) : (
            <span class="text-rose-400 truncate ml-2">JSON.parse FAILED · {parseError}</span>
          )}
        </div>
        <div class="flex flex-col gap-1 col-span-2 pt-2 border-t border-zinc-800/60">
          <span class="text-zinc-400">SHA256</span>
          <span class="text-zinc-300 break-all text-[11px]">{sha256}</span>
        </div>
      </div>
    </div>

    {/* SECTION 01: THE FILE — cat output with line numbers + syntax colouring, from the real file */}
    <SectionHeader num="01" title="The File" />
    <p class="text-[15px] leading-relaxed text-zinc-300 font-sans mb-6">
      The résumé as structured data. JSON Resume fields where they fit (<code class={codeClass}>basics</code>, <code class={codeClass}>work</code>, <code class={codeClass}>projects</code>, <code class={codeClass}>skills</code>) and one extension, <code class={codeClass}>open_to</code>. Every number sits in a sentence with its date or its method, so a reader can tell a measurement from a memory.
    </p>

    <Prompt path="~/resume" cmd="cat experience.json" />

    <div class="bg-[#050505] border border-zinc-800/80 rounded-sm mb-12 shadow-lg overflow-hidden flex flex-col font-mono text-[12px] md:text-[13px] leading-[1.6]">
      <div class="bg-zinc-900/50 border-b border-zinc-800 px-4 py-2 text-[10px] text-zinc-400 uppercase tracking-widest flex justify-between">
        <span>experience.json</span>
        <span>JSON · {lineCount} lines · {sizeBytes.toLocaleString('en-US')} bytes</span>
      </div>
      <div class="p-4 flex overflow-x-auto">
        <div class="text-zinc-600 text-right pr-4 select-none flex flex-col shrink-0" aria-hidden="true">
          {renderedLines.map((_, i) => <span>{i + 1}</span>)}
        </div>
        <div class="text-zinc-300 whitespace-pre flex flex-col">
          {renderedLines.map((toks) => (
            <span>{toks.length === 0 ? ' ' : toks.map((t) => (t.c ? <span class={t.c}>{t.t}</span> : t.t))}</span>
          ))}
        </div>
      </div>
    </div>

    {/* SECTION 02: COMMON QUERIES — answers computed from the parsed file */}
    <SectionHeader num="02" title="Common Queries" />
    <p class="text-[15px] leading-relaxed text-zinc-300 font-sans mb-6">
      The file is structured, so a fact can be pulled without reading prose. The answers below are computed from the file when the site builds, not typed in; pipe the raw file through <code class={codeClass}>jq</code> and you get the same lines.
    </p>

    <div class="space-y-3 mb-12">
      {parseOk ? (
        queries.map((q) => (
          <div class="bg-[#050505] border border-zinc-800/80 rounded-sm font-mono text-[12px] overflow-hidden">
            <div class="px-4 py-2 border-b border-zinc-800/60 text-zinc-400">
              <span class="text-emerald-500/90">$</span> jq <span class="text-[#e2cb85]">'{q.filter}'</span> experience.json
            </div>
            <div class="px-4 py-2 text-[#e2cb85] whitespace-pre">{q.out.join('\n')}</div>
          </div>
        ))
      ) : (
        <div class="bg-[#050505] border border-rose-500/40 rounded-sm font-mono text-[12px] px-4 py-3 text-rose-400">
          The file did not parse at build time, so no queries are shown. {parseError}
        </div>
      )}
    </div>

    {/* SECTION 03: SCHEMA NOTES */}
    <SectionHeader num="03" title="Schema Notes" />
    <div class="space-y-5 text-[15px] md:text-[16px] leading-relaxed text-zinc-300 font-sans mb-12">
      <p>
        <a href="https://jsonresume.org/schema/" target="_blank" rel="noopener noreferrer" class="text-emerald-400 hover:text-emerald-300 no-underline border-b border-emerald-400/30 hover:border-emerald-400/60">JSON Resume<span class="sr-only"> (opens in a new tab)</span></a> where it fits: <code class={codeClass}>basics</code>, <code class={codeClass}>work</code>, <code class={codeClass}>projects</code> and <code class={codeClass}>skills</code> are the schema's own fields. One extension, <code class={codeClass}>open_to</code>, says what I am looking for: Software Engineer or Applied AI, Seattle on-site or hybrid first, remote considered.
      </p>
      <p>
        What is not in the file, on purpose. No portfolio-wide test total: each count is per repo, with its date. No present-tense status for anything that was not measured on the date shown. No compensation fields; those numbers belong to an offer conversation, not a public file.
      </p>
      <p>
        The figures on this page (size, lines, sha256, parse result, last commit) are computed from the file and from git when the site builds. Edit the file and they follow.
      </p>
    </div>

    {/* FOOTER — download buttons */}
    <div class="border-t border-zinc-800/80 pt-12 pb-24 flex flex-col items-center text-center gap-3">
      <a
        href="/experience.json"
        target="_blank"
        rel="noopener noreferrer"
        class="bg-[#0a0a0c] text-zinc-300 border border-zinc-700 px-8 py-3 uppercase font-mono font-bold tracking-widest text-[13px] hover:bg-zinc-800 hover:text-white hover:border-emerald-500/50 hover:shadow-[0_0_24px_rgba(16,185,129,0.15)] transition-all no-underline group inline-flex items-center gap-3"
      >
        <span class="text-emerald-500 group-hover:animate-pulse" aria-hidden="true">&gt;</span>
        Download experience.json (raw)<span class="sr-only"> (opens in a new tab)</span>
        <span class="text-emerald-500/60 group-hover:text-emerald-400 transition-colors" aria-hidden="true">↓</span>
      </a>
      <a
        href="/resume.pdf"
        class="bg-transparent text-zinc-400 border border-zinc-800 px-8 py-3 uppercase font-mono font-bold tracking-widest text-[12px] hover:bg-zinc-800 hover:text-zinc-200 transition-colors no-underline inline-flex items-center gap-3"
      >
        <span class="text-zinc-500" aria-hidden="true">&gt;</span>
        Download resume.pdf
        <span class="text-zinc-500" aria-hidden="true">↓</span>
      </a>
      <div class="text-zinc-400 font-mono text-[11px] uppercase tracking-widest mt-3">
        updated {lastUpdated} · v{version} · page built {builtAt}
      </div>
    </div>

    <div class="flex items-center text-zinc-600 font-mono text-[12px] select-none opacity-50 pb-8">
      EOF <span class="ml-2 w-1.5 h-3 bg-zinc-400 inline-block cursor-blink"></span>
    </div>
  </div>

  {/* OBSERVABILITY SLOT — file-context dashboard, every value computed at build */}
  <Fragment slot="observability">
    <div class="flex flex-col gap-6">
      <div class={`font-mono font-normal text-[10px] uppercase tracking-wider ${gitLive ? 'text-emerald-500/80' : 'text-amber-400/80'}`}>
        {gitLive ? 'TRACKED IN GIT' : 'GIT UNAVAILABLE AT BUILD'}
      </div>

      <div class="grid grid-cols-1 gap-3">
        {parseOk ? (
          <PhysicalCard title="Schema" value="Valid" sub="JSON.parse at build" success />
        ) : (
          <PhysicalCard title="Schema" value="Invalid" sub="JSON.parse failed at build" alert />
        )}
        <PhysicalCard title="Lines" value={String(lineCount)} sub={`${sizeBytes.toLocaleString('en-US')} B · UTF-8`} />
        <PhysicalCard title="Updated" value={lastUpdated} sub="_last_updated, in the file" />
      </div>

      {/* Last Commit — read from git at build */}
      <div class="mt-2">
        <div class="text-[10px] uppercase tracking-widest text-zinc-400 font-sans font-bold mb-3 flex items-center justify-between">
          <span>Last Commit</span>
          <span class="bg-zinc-800 text-zinc-400 px-1 py-0.5 rounded-sm">git</span>
        </div>
        <div class="font-mono text-[10px] bg-[#050505] border border-zinc-800/60 rounded-sm p-3">
          <div class="space-y-2 text-zinc-400">
            <div class="flex justify-between">
              <span class="text-zinc-400">SHA</span>
              <span class="text-zinc-300">{commit.sha}</span>
            </div>
            <div class="flex justify-between">
              <span class="text-zinc-400">DATE</span>
              <span class="text-zinc-300">{commit.date}</span>
            </div>
            <div class="flex flex-col gap-0.5 pt-1">
              <span class="text-zinc-400">SOURCE</span>
              <span class="text-zinc-300">{commit.source}</span>
            </div>
          </div>
        </div>
      </div>

      {/* Remote Pointers */}
      <div class="mt-2">
        <div class="text-[10px] uppercase tracking-widest text-zinc-400 font-sans font-bold mb-3">Remote Pointers</div>
        <div class="flex flex-col gap-2 font-mono text-[11px]">
          <a href="/experience.json" target="_blank" rel="noopener noreferrer" class={pointerClass}>
            <span>&gt; raw .json<span class="sr-only"> (opens in a new tab)</span></span>
            <span class="opacity-0 group-hover:opacity-100 transition-opacity text-emerald-500" aria-hidden="true">↓</span>
          </a>
          <a href="/resume.pdf" class={pointerClass}>
            <span>&gt; resume.pdf</span>
            <span class="opacity-0 group-hover:opacity-100 transition-opacity text-emerald-500" aria-hidden="true">↓</span>
          </a>
          <a href="/" class={pointerClass}>
            <span>&gt; about.md</span>
            <span class="opacity-0 group-hover:opacity-100 transition-opacity text-emerald-500" aria-hidden="true">↗</span>
          </a>
          <a href="mailto:cjdavis766@gmail.com" class={pointerClass}>
            <span>&gt; contact</span>
            <span class="opacity-0 group-hover:opacity-100 transition-opacity text-emerald-500" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </Fragment>
</Workspace>
