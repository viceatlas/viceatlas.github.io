---
/**
 * Page-open counter — replaces Figma's `useUptime()` hook.
 *
 * Renders `PAGE OPEN FOR 00:00:14` and increments every second from page load
 * via an inline script. It is a per-page-load clock and says so: it is not
 * the uptime of any system. Each navigation resets it.
 *
 *   <Uptime />
 *
 * The home page does not use it; system health there comes from
 * `src/lib/live.ts`, fetched at build with its fetch time.
 */
---

<span class="font-mono text-[10px] text-zinc-400 uppercase tracking-wider">
  page open for <span data-uptime class="text-emerald-500">00:00:00</span>
</span>

<script is:inline>
  (function () {
    const el = document.currentScript.previousElementSibling.querySelector('[data-uptime]');
    if (!el) return;
    let seconds = 0;
    function tick() {
      const h = String(Math.floor(seconds / 3600)).padStart(2, '0');
      const m = String(Math.floor((seconds % 3600) / 60)).padStart(2, '0');
      const s = String(seconds % 60).padStart(2, '0');
      el.textContent = `${h}:${m}:${s}`;
      seconds++;
    }
    tick();
    setInterval(tick, 1000);
  })();
</script>
